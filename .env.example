# Base URL of your Evolution API instance (no trailing slash)
EVOLUTION_BASE_URL=https://your-evolution-instance.com

# Global API key (header: apikey). Grants full control over the instance — keep secret.
EVOLUTION_API_KEY=your-global-apikey

# Optional: default WhatsApp instance name used when a tool call omits "instance".
EVOLUTION_DEFAULT_INSTANCE=myinstance

# Optional: comma-separated allowlist of tool groups to expose.
# Core groups (default when unset): server,instance,settings,message,chat,profile,label,group,webhook
# Opt-in groups: proxy,template,business,websocket,rabbitmq,sqs,nats,kafka,pusher,chatwoot,
#                typebot,openai,dify,evolutionbot,flowise,n8n,evoai
# Use "all" to expose every group.
# EVOLUTION_TOOLS=instance,message,chat,group

# Optional: request timeout in milliseconds (default 30000). Sends with a `delay` wait
# timeout + delay, because Evolution holds the request open for the delay.
# EVOLUTION_TIMEOUT_MS=30000

# Optional: largest incoming MCP message in bytes (default 67108864 = 64 MiB), e.g. a tool
# call carrying base64 media. Over stdio a bigger message closes the connection (logged on
# stderr); in HTTP mode a bigger request body gets HTTP 413.
# EVOLUTION_MAX_MESSAGE_BYTES=67108864

# Optional: largest tool result in bytes (default 4194304 = 4 MiB over stdio, 150000 in HTTP
# mode, where claude.ai caps a tool result at about 150,000 characters). In a bigger result, text
# values over 64 KiB (e.g. media base64 echoed by a send) are replaced by "<omitted: N bytes>"
# and the rest is returned. It becomes an error with a summary only when that is not enough,
# or always for evolution_chat_media_base64.
# Keep it well below your client's limit: Claude Code drops MCP servers whose messages
# exceed 10 MiB (Claude Desktop: 32 MiB).
# EVOLUTION_MAX_RESULT_BYTES=4194304

# ----------------------------------------------------------------------------------------------
# HTTP mode (optional)
# ----------------------------------------------------------------------------------------------
# By default the server speaks MCP over stdio. MCP_TRANSPORT=http serves Streamable HTTP
# (stateless) for remote clients such as Claude connectors, Claude Code and ChatGPT, behind an
# HTTPS reverse proxy. It refuses to start without an explicit authentication decision, because
# EVOLUTION_API_KEY gives full control of every WhatsApp instance. GET /health is a liveness
# probe that needs no token. EVOLUTION_MAX_RESULT_BYTES defaults to 150000 in this mode.
# MCP_TRANSPORT=http

# Interface to listen on (default 127.0.0.1; the Docker image sets MCP_HOST=0.0.0.0) and port:
# MCP_PORT, else PORT (set by platforms such as Cloud Run, Heroku or Render), else 3000. The image
# leaves both port variables unset.
# MCP_HOST=127.0.0.1
# MCP_PORT=3000

# Public URL of the MCP endpoint, exactly as users type it into their client. Must be https
# (plain http only for localhost or 127.0.0.1). It is the RFC 9728 resource and the default OAuth
# audience, its path is the endpoint path, and its host (plus localhost and 127.0.0.1) is the
# only Host header accepted. A URL without a path serves MCP at / and is advertised without a
# trailing slash (https://mcp-evo.example.com); tokens for it may carry either form.
# MCP_PUBLIC_URL=https://mcp-evo.example.com/mcp

# Endpoint path (default /mcp, or the path of MCP_PUBLIC_URL, which it must then match).
# MCP_PATH=/mcp

# Comma-separated host names accepted in the Host header, instead of the MCP_PUBLIC_URL host.
# With neither variable set the Host header is not checked (a warning is logged). Any other Host
# gets 403 and the log shows the value:
#   rejected Host "<value>": not in MCP_ALLOWED_HOSTS / MCP_PUBLIC_URL
# MCP_ALLOWED_HOSTS=mcp-evo.example.com

# Comma-separated origins allowed to call the endpoint. A request with any other Origin header gets
# 403; requests without one are not affected. Origins are compared as scheme://host[:port], so a
# trailing slash or capital letters do not matter (https://Claude.ai/ matches https://claude.ai).
# Hosted Claude has been seen sending an Origin header, and Anthropic warns that a strict Origin
# check can reject Claude, so for the claude.ai and ChatGPT connectors set:
#   MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com
# A rejected request is logged with the value to add here if the client is legitimate:
#   rejected Origin "<value>": not in MCP_ALLOWED_ORIGINS
# MCP_ALLOWED_ORIGINS=

# true answers each request with plain JSON instead of an SSE stream (default false). SSE sends
# a keep-alive comment every 15 s, which keeps long tool calls alive through proxies.
# MCP_JSON_RESPONSE=false

# On SIGTERM/SIGINT, milliseconds to let in-flight requests finish before exiting (default 8000,
# under Docker's 10 s stop timeout).
# MCP_SHUTDOWN_TIMEOUT_MS=8000

# Authentication: bearer, oauth or none. When unset it is inferred from MCP_AUTH_TOKEN (bearer)
# or MCP_OAUTH_ISSUER (oauth); with both set you must choose one here.
# MCP_AUTH_MODE=bearer

# bearer: static token(s) sent as "Authorization: Bearer <token>". Each token needs at least 32
# characters, e.g. from `openssl rand -base64 32`. A comma-separated list allows rotation: add
# the new token, update the clients, then remove the old one. Works with Claude Code:
#   claude mcp add --transport http evolution https://mcp-evo.example.com/mcp \
#     --header "Authorization: Bearer <token>"
# ChatGPT cannot send custom headers, and claude.ai only in a limited beta: use oauth for them.
# MCP_AUTH_TOKEN=

# oauth: OAuth 2.1 resource server for an external IdP (WorkOS AuthKit, Auth0, Keycloak, Logto,
# ...). Requires MCP_PUBLIC_URL. Accepts JWT access tokens signed by the issuer, for the audience
# and not expired (30 s clock tolerance); a bad token gets 401 with a WWW-Authenticate header that
# points at the protected resource metadata, a valid token for a subject that is not allowed gets
# 403 without that header, and an unreachable IdP gets 500. The log says why each token failed.
# Issuer exactly as in the IdP's discovery document (Auth0's ends with "/"); https required.
# MCP_OAUTH_ISSUER=https://idp.example.com/
# Expected `aud` claim (default MCP_PUBLIC_URL; for a URL without a path, with or without the
# trailing slash).
# MCP_OAUTH_AUDIENCE=https://mcp-evo.example.com/mcp
# JWKS endpoint (default: jwks_uri from the issuer's OIDC discovery or RFC 8414 metadata). Must be
# https; plain http only for a private host: loopback, a single-label name such as a Docker service
# (http://keycloak:8080/...), a .internal or .local name, or an RFC 1918/ULA address. Any other
# plain-http URL stops the server at startup.
# MCP_OAUTH_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# Space- or comma-separated scopes every token must carry (optional; missing ones get 403).
# MCP_OAUTH_REQUIRED_SCOPES=
# Comma-separated `sub` claims of the users allowed in (required), or
# MCP_OAUTH_ALLOW_ANY_SUBJECT=true when the IdP itself only admits those users. A token for any
# other subject gets 403 and the log shows its sub:
#   token rejected: sub "<sub>" is not in MCP_OAUTH_ALLOWED_SUBJECTS
# MCP_OAUTH_ALLOWED_SUBJECTS=
# MCP_OAUTH_ALLOW_ANY_SUBJECT=false

# none: no authentication, only behind a gateway that authenticates every request. Requires
# MCP_ALLOW_UNAUTHENTICATED=true.
# MCP_ALLOW_UNAUTHENTICATED=false
